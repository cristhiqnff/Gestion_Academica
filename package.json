{
  "name": "gestion-academica",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de gestión académica: estudiantes, docentes, asignaturas, calificaciones y reportes",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "db:preparar": "node src/db/preparar.js",
    "db:verificar": "node src/db/verificar.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.1"
  }
}
