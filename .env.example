# Copia este archivo como .env para desarrollo local.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
SESSION_SECRET=cambia-esta-clave-en-produccion

# Ruta del archivo SQLite (por defecto datos/academico.db)
# DB_PATH=./datos/academico.db

# Cookies Secure cuando la aplicación se sirve por HTTPS
# COOKIE_SECURE=true

# Contraseñas iniciales de la demo (opcionales, mínimo 8 caracteres).
# Si no se definen se usan Admin123* y Docente123*.
# ADMIN_PASSWORD=Admin123*
# DOCENTE_PASSWORD=Docente123*
